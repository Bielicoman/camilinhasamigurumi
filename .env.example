# Copie para .env.local (nunca faça commit desse arquivo) ou cadastre no painel da Vercel:
# Project → Settings → Environment Variables.

# Access Token do Mercado Pago (Suas integrações → Credenciais).
# Em teste use o de "Credenciais de teste"; em produção, o de produção.
MP_ACCESS_TOKEN=

# Assinatura secreta dos Webhooks (Suas integrações → Webhooks → Configurar notificações).
MP_WEBHOOK_SECRET=

# Endereço público do site, com https e sem barra no final.
SITE_URL=https://camilinhasamigurumi.vercel.app

# E-mail via Resend (resend.com): aviso ao ateliê e entrega da licença do Ponto a Ponto Pro.
# Obrigatório para vender o Pro. ORDER_FROM_EMAIL precisa ser de um domínio verificado no Resend
# (o remetente de teste resend.dev só entrega para o e-mail dono da conta).
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
ORDER_FROM_EMAIL=

# Ponto a Ponto Pro: segredo que assina as chaves de licença (gere com `openssl rand -hex 32`).
# Nunca troque depois de vender: as chaves já emitidas deixariam de valer.
LICENCA_SEGREDO=
# Origens (vírgula) que podem chamar /api/licenca pelo navegador. Apps instalados não enviam Origin.
LICENCA_ORIGENS=https://pontoapontocroche.vercel.app
